lib.utm_content = TEXT
lib.utm_content.value =

[request && traverse(request.getQueryParams(), 'utm_content') > 0]
    config {
        no_cache = 1
        index_enable = 0
        admPanel = 0
        disableAllHeaderCode = 1
        removeDefaultJS = 1
        removeDefaultCss = 1
        includeCSS >
        includeJS >
    }
    lib.utm_content.data = GP:utm_content
    page {
        10 = CONTENT
        10 {
            table = tt_content
            select.uidInList.data = GP:utm_content
        }
    }
[END]
